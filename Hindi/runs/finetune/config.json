{
  "stage": "reasoning_finetune",
  "init_checkpoint": "Hindi/checkpoints/best.pt",
  "init_checkpoint_step": 15981,
  "tokenizer": "Hindi/tokenizer/hi_unigram_16000.model",
  "data": "Hindi/data/reasoning",
  "train_examples": 20000,
  "validation_examples": 1000,
  "epochs": 4.8,
  "loss": "cross-entropy on answer tokens and EOS only; prompt targets masked",
  "model": {
    "vocab_size": 16000,
    "block_size": 512,
    "n_layer": 10,
    "n_head": 6,
    "d_model": 384,
    "d_ff": 1536,
    "dropout": 0.1,
    "bias": true,
    "tie_embeddings": true,
    "use_positional": true
  },
  "train": {
    "batch_size": 32,
    "grad_accum": 4,
    "max_steps": 750,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "eval_interval": 50,
    "eval_batches": 16,
    "checkpoint_interval": 50,
    "keep_checkpoints": 2,
    "log_interval": 10,
    "seed": 1337,
    "device": "auto",
    "dtype": "auto",
    "freeze_embeddings": true
  },
  "schedule": {
    "max_lr": 0.0001,
    "min_lr": 1e-05,
    "warmup_steps": 50,
    "max_steps": 750
  },
  "checkpoint_dir": "Hindi/checkpoints/finetune"
}
